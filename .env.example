# ---- Experiment profile (the only switch for the orchestration strategy) ----
# Primary comparison:
#   baseline               LLM -> direct tool calling (tools run as soon as the LLM calls them)
#   planned                LLM -> structured ExecutionPlan -> deterministic validation (incl. request grounding)
#                          -> one validator-feedback repair -> execution
# Ablations (secondary, not part of the headline comparison):
#   baseline_step_guard    direct tool calling, each call checked by the validator + grounding first
#   planned_no_repair      one-shot plan, no repair
#   planned_no_grounding   validator without request-grounding checks
#   planned_minimal        one-shot plan + contract/state validator only (earlier primary)
#   planned_no_validator   plan executed without validation
#   planned_strict_schema  provider-side strict JSON schema for the plan
#   planned_auto_prereq    deterministic insertion of missing export_yolo steps
# `uv run cvorch profiles` lists them. CLI `--profile` overrides this value.
ORCH_PROFILE=planned

# ---- LLM (shared by every profile) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# ---- Baseline loop ----
# Max LLM <-> tool round trips in the direct tool-calling loop
BASELINE_MAX_ROUNDS=8

# ---- Shared tool runtime ----
# true/false: tools check argument types/ranges at call time (same for both strategies)
TOOL_ARG_VALIDATION=true

# ---- Benchmark ----
BENCH_CONCURRENCY=1
