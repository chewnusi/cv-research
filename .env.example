# ---- Orchestration approach (main independent variable) ----
# baseline : LLM -> direct tool calling (tools executed as soon as the LLM calls them)
# planned  : LLM -> structured plan -> deterministic validation -> execution
ORCH_MODE=planned

# ---- LLM (any OpenAI-compatible endpoint: OpenAI, OpenRouter, Ollama, vLLM, ...) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_TIMEOUT_S=60

# ---- Baseline options ----
# Max LLM <-> tool round trips in the direct tool-calling loop
BASELINE_MAX_ROUNDS=8

# ---- Planned-method options (ablations) ----
# true/false: run the deterministic validator before execution
PLANNER_VALIDATE=true
# How many times the planner may revise a plan after validator feedback (0 = no repair)
PLANNER_REPAIR_ATTEMPTS=1
# json_object : JSON mode, plan schema described in the prompt
# json_schema : strict provider-side schema (tool names + argument names enforced by the decoder)
PLANNER_RESPONSE_FORMAT=json_schema
# true/false: deterministically insert missing segment/export steps based on dataset state
PLANNER_AUTO_PREREQUISITES=true

# ---- Shared tool runtime ----
# true/false: tools check argument types/ranges at call time (as a typical tool framework would)
TOOL_ARG_VALIDATION=true

# ---- Benchmark ----
BENCH_CONCURRENCY=1
